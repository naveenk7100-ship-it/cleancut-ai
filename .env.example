# ==============================================================================
# CleanCut AI — Environment Configuration Example
# ==============================================================================

# --- Frontend (Next.js / Vercel) ---
# The URL where your Python inpainting backend is hosted.
# Leave empty for local development, or set to your deployed backend URL (e.g., https://cleancut-backend.onrender.com)
NEXT_PUBLIC_API_URL=

# --- Backend (FastAPI Container) ---
# Port for the FastAPI server (Default: 8000)
PORT=8000

# Permitted CORS origins (comma-separated, or * for all)
ALLOWED_ORIGINS=https://cleancut-ai.vercel.app,http://localhost:3000

# Maximum allowed upload size in Megabytes (Default: 500)
MAX_UPLOAD_MB=500

# Maximum concurrent video processing jobs (Default: 2)
MAX_CONCURRENT_JOBS=2

# Persistent or temporary storage directory path
STORAGE_DIR=./storage
